# Kredensial E-Learning UMN
UMN_USERNAME=your_nim_or_sso_username
UMN_PASSWORD=your_sso_password
UMN_BASE_URL=https://elearning.umn.ac.id

# Google Gemini API Key (bisa didapat gratis di https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# === LLM Provider: gemini (default) | openrouter ===
LLM_PROVIDER=gemini
# OpenRouter API key — ambil gratis di https://openrouter.ai/keys (wajib kalau pakai openrouter)
OPENROUTER_API_KEY=
# Model OpenRouter default (bisa diganti juga via /model di Telegram)
OPENROUTER_MODEL=minimax/minimax-m3:free
# Opsional: paksa model Gemini tertentu (kalau kosong = auto-fallback bawaan)
# GEMINI_MODEL=gemini-flash-lite-latest

# Telegram Bot Kredensial (Dibuat via @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Chat ID Telegram kamu (bisa didapat via bot @userinfobot di Telegram)
TELEGRAM_CHAT_ID=your_chat_id

# Pengaturan Jadwal Cron / Reminder (WIB)
MORNING_BRIEFING_TIME=07:00
EVENING_REMINDER_TIME=18:00
AUTO_SYNC_HOURS=06:00,18:00

# === Assignment Auto-Worker (AI kerjakan tugas, kirim .docx ke Telegram) ===
# Identitas untuk header dokumen tugas (kosong = auto dari email UMN)
STUDENT_NAME=Nama Kamu
STUDENT_NIM=00000000
# Cron harian: kerjakan tugas pending yang belum pernah dikerjakan
AUTO_DO_ASSIGNMENTS=true
AUTO_DO_ASSIGNMENTS_TIME=19:00
AUTO_DO_MAX_PER_RUN=2

# Tanggal kuliah pertama minggu-1 semester ini (YYYY-MM-DD) — WAJIB diisi
# supaya briefing tahu "minggu ke-N" dan sesuai roadmap RPKPS
SEMESTER_START_DATE=2026-08-24
# Minggu libur akademik gak dihitung sebagai minggu kuliah (UTS: 12-24 Okt 2026)
SEMESTER_BREAKS=2026-10-12:2026-10-24
